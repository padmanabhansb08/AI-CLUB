NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://aiclub:aiclub_password@localhost:5432/aiclub_db
DATABASE_SSL=false
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Required for password-reset and verification email delivery. Never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Supabase Server-Side Configuration (Optional for direct PostgreSQL & Supabase Admin Operations)
# The service-role key must remain strictly server-side and never be exposed to the browser/client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sprint 8: AI Intelligence Layer
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=15000
AI_ENABLED=true
AI_RECOMMENDATIONS_ENABLED=true
AI_ASSISTANT_ENABLED=true
AI_SKILL_ANALYSIS_ENABLED=true
AI_ADMIN_INSIGHTS_ENABLED=true
