# ==============================================================================
# AI CLUB — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Frontend: Copy the VITE_* variables into a root `.env` file for Vite UI dev.
# 2. Backend: Copy the Server & Database variables into `server/.env`.
# 3. Security: NEVER expose SUPABASE_SERVICE_ROLE_KEY or database passwords in
#    frontend client code or commit real production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client)
# ------------------------------------------------------------------------------
# Backend API Base URL (Express server running on port 5000)
VITE_API_URL=http://localhost:5000/api

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous Key (Browser safe; guarded by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER & BACKEND CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
# Server Environment & Port
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://aiclub:aiclub_password@localhost:5432/aiclub_db

# JWT Authentication Secret & Token Expiry
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Allowed CORS Origin for Frontend Client
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. SUPABASE SERVER-SIDE CONFIGURATION (SERVER ONLY)
# ------------------------------------------------------------------------------
# Required for server-side admin operations and privileged migrations.
# CRITICAL SECURITY RULE: The Service Role Key bypasses all Row Level Security.
# NEVER prefix with VITE_ or expose to client-side code!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 4. AI INTELLIGENCE LAYER CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=15000
AI_ENABLED=true
AI_RECOMMENDATIONS_ENABLED=true
AI_ASSISTANT_ENABLED=true
AI_SKILL_ANALYSIS_ENABLED=true
AI_ADMIN_INSIGHTS_ENABLED=true
